minimumReleaseAge=0

; zfb 2.x's bundler runs esbuild over a "shadow tree" whose module resolution
; starts at the PROJECT ROOT, so every bare specifier reachable from the
; page/SSR graph must resolve from `<root>/node_modules`. `hono` is only a
; transitive dep (`@takazudo/zfb-runtime` -> `hono`), and pnpm's default strict
; layout does not link a transitive dep there — so `zfb dev` fails to bundle
; `@takazudo/zfb-runtime/dist/router.js` (`Could not resolve "hono"`) and
; silently degrades to "renderer disabled — falling back to empty page cache".
; `zfb build` is unaffected; only the dev renderer needs the server router.
; Public-hoisting just `hono` is the narrowest fix. Remove this once zfb
; resolves runtime deps relative to the importing package.
; (This replaces pnpm's default public-hoist-pattern of *eslint*/*prettier*;
; neither is used in this project.)
public-hoist-pattern[]=hono
