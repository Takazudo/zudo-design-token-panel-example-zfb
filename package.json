{
  "name": "zudo-design-token-panel-example-zfb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "zfb (zudo-front-builder) example app demonstrating @takazudo/zdtp — host-config-driven panel mounted as a Preact island via zfb's Island component, plus apply-pipeline round-trip via a devMiddleware plugin that proxies to the bin sidecar.",
  "scripts": {
    "predev": "rm -rf dist .zfb .zfb-build zfb-tailwind-entry-*.css",
    "dev": "node scripts/launch.mjs dev",
    "_dev:zfb": "node scripts/launch.mjs dev:zfb",
    "_dev:tokens-bin": "node scripts/launch.mjs dev:sidecar",
    "build": "zfb build",
    "preview": "node scripts/launch.mjs preview",
    "typecheck": "zfb check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.5.1",
    "@takazudo/zfb": "2.15.1",
    "@takazudo/zfb-runtime": "2.15.1",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "wrangler": "4.129.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.34"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
